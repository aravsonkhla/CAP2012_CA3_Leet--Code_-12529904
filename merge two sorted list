#include <stdlib.h>

// Definition for singly-linked list node provided by LeetCode
struct ListNode {
    int val;
    struct ListNode *next;
};

struct ListNode* mergeTwoLists(struct ListNode* list1, struct ListNode* list2) {
    // A dummy node serves as a placeholder anchor for our new merged list.
    // It eliminates having to write repetitive logic to set up the head node.
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = NULL;
    
    struct ListNode* current = &dummy;

    // Run the loop as long as both lists have nodes left to compare
    while (list1 != NULL && list2 != NULL) {
        if (list1->val <= list2->val) {
            current->next = list1; // Link the smaller node
            list1 = list1->next;   // Advance the pointer in list1
        } else {
            current->next = list2; // Link the smaller node
            list2 = list2->next;   // Advance the pointer in list2
        }
        current = current->next;   // Advance our tracking pointer forward
    }

    // Splicing shortcut: If one list runs dry, wire the rest of the 
    // remaining active list directly to the end of our merged list.
    if (list1 != NULL) {
        current->next = list1;
    } else {
        current->next = list2;
    }

    // The actual merged list starts right after the temporary dummy node
    return dummy.next;
}
