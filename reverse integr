class Solution {
public:
    bool isPalindrome(int x) {
        // Edge cases: Negative numbers and numbers ending in 0 (except 0 itself)
        // can never be palindromes.
        if (x < 0 || (x % 10 == 0 && x != 0)) {
            return false;
        }

        int reversedHalf = 0;
        
        // Peel digits off the back of x and shift them into reversedHalf
        while (x > reversedHalf) {
            reversedHalf = (reversedHalf * 10) + (x % 10);
            x /= 10;
        }

        // For even lengths: x == reversedHalf (e.g., 12 == 12)
        // For odd lengths: x == reversedHalf / 10 to ignore the middle digit (e.g., 12 == 123/10)
        return x == reversedHalf || x == reversedHalf / 10;
    }
};
