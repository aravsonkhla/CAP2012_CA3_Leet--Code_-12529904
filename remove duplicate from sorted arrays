int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) return 0;

    int k = 1; // Tracks the count of unique elements

    for (int i = 1; i < numsSize; i++) {
        // If it's a new number we haven't seen, pull it forward
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i];
            k++;
        }
    }

    return k;
}
