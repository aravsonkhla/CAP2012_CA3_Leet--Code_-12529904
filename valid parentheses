#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // Quick optimization: an odd length can never be balanced
    if (len % 2 != 0) return false;

    // Use a simple char array as our stack container
    char stack[len];
    int top = -1;

    for (int i = 0; s[i] != '\0'; i++) {
        char c = s[i];

        // If it's an opening bracket, push it onto the stack
        if (c == '(' || c == '{' || c == '[') {
            top++;
            stack[top] = c;
        } 
        // If it's a closing bracket, verify the stack isn't empty and matches top
        else {
            if (top == -1) return false; 
            
            char open = stack[top];
            top--;

            if ((c == ')' && open != '(') ||
                (c == '}' && open != '{') ||
                (c == ']' && open != '[')) {
                return false;
            }
        }
    }

    // If the stack is completely empty, all pairs matched perfectly
    return top == -1;
}
